@page "/cours"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PlateE_learning.Models
@using PlateE_learning.Data
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Catalogue des Cours - CRMS-UOB</PageTitle>

<!-- EN-TÊTE PAGE DE CATALOGUE -->
<section class="catalog-header bg-white border-bottom py-4 py-lg-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                
                <h1 class="fw-bold text-dark display-6 mb-2">Catalogue des Cours</h1>
                <p class="text-muted mb-0 fs-6">
                    Explorez nos programmes de formation médicale continue et développez vos compétences au quotidien.
                </p>
            </div>

            <!-- Barre de Recherche -->
            <div class="col-lg-6">
                <div class="search-box position-relative ms-lg-auto" style="max-width: 480px;">
                    <input type="text"
                           class="form-control form-control-lg ps-5 rounded-pill border-2 shadow-sm"
                           placeholder="Rechercher par cours, sujet ou enseignant..."
                           @bind="SearchQuery"
                           @bind:event="oninput" />
                    <span class="position-absolute top-50 start-0 translate-middle-y ms-3 text-muted fs-5">
                        🔍
                    </span>
                </div>
            </div>
        </div>

        <!-- Filtres par Type de Cours -->
        <div class="d-flex align-items-center gap-2 overflow-x-auto pt-4 mt-2 no-scrollbar">
            <button class="btn btn-sm @(SelectedType == "Tous" ? "btn-warning fw-bold" : "btn-outline-secondary") rounded-pill px-3 py-2 text-nowrap"
                    @onclick='() => FilterByType("Tous")'>
                Tous les cours (@FilteredCoursCount)
            </button>
            <button class="btn btn-sm @(SelectedType == "Vidéo" ? "btn-warning fw-bold" : "btn-outline-secondary") rounded-pill px-3 py-2 text-nowrap"
                    @onclick='() => FilterByType("Vidéo")'>
                Formations Vidéo
            </button>
            <button class="btn btn-sm @(SelectedType == "Texte" ? "btn-warning fw-bold" : "btn-outline-secondary") rounded-pill px-3 py-2 text-nowrap"
                    @onclick='() => FilterByType("Texte")'>
                Formations Texte
            </button>
        </div>
    </div>
</section>

<!-- GRILLE DES COURS -->
<section class="py-5 bg-light min-vh-100">
    <div class="container">
        @if (ListCours == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="text-muted mt-2">Chargement du catalogue...</p>
            </div>
        }
        else if (!FilteredCours.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border shadow-sm my-4 p-5">
                <div class="fs-1 mb-3">📚</div>
                <h5 class="fw-bold text-dark">Aucun cours trouvé</h5>
                <p class="text-muted small mb-3">Essayez de modifier votre recherche ou vos filtres.</p>
                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="ResetFilters">
                    Réinitialiser les filtres
                </button>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var cours in FilteredCours)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden course-card bg-white">

                            <!-- Vignette avec Badge Type -->
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(cours.MiniatureUrl) ? "images/course-default.svg" : cours.MiniatureUrl)"
                                     class="card-img-top course-img"
                                     alt="@cours.Titre" />
                                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-3 shadow-sm rounded-pill px-3 py-2 fw-semibold border">
                                    @(cours.Type == "Vidéo" ? "Vidéo" : "Texte")
                                </span>
                            </div>

                            <!-- Contenu de la Carte -->
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-primary-subtle text-primary fw-bold">@cours.Statut</span>
                                        <small class="text-muted fw-bold">CRMS-UOB</small>
                                    </div>

                                    <h5 class="fw-bold text-dark mb-2 line-clamp-2 title-hover">
                                        @cours.Titre
                                    </h5>

                                    <p class="text-muted small mb-3 line-clamp-3">
                                        @cours.Description
                                    </p>

                                    <!-- SECTION 3 INFOS : CHAPITRES / TYPE / CERTIFICATION -->
                                    <div class="course-meta-bar d-flex align-items-center justify-content-between bg-light rounded-3 p-2 mb-3 text-muted border-light">
                                        <div class="d-flex align-items-center gap-1">
                                           
                                            <span>@cours.NombreChapitres chap.</span>
                                        </div>
                                        <div class="border-end h-100 mx-1"></div>
                                        <div class="d-flex align-items-center gap-1">
                                            
                                            <span>@(cours.NombreChapitres * 20) min</span>
                                        </div>
                                        <div class="border-end h-100 mx-1"></div>
                                        <div class="d-flex align-items-center gap-1">
                                            @if (cours.AAccesCertificat)
                                            {
                                                <span class="text-success fw-semibold">Certifié</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Standard</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- PIED DE CARTE : ENSEIGNANT DE LA TABLE ENSEIGNANTS / UTILISATEURS -->
                                <!-- PIED DE CARTE : ENSEIGNANT DE LA TABLE ENSEIGNANTS / UTILISATEURS -->
                                <div class="pt-3 border-top d-flex align-items-center justify-content-between mt-auto gap-2">
                                    <!-- Groupe Photo + Info Enseignant -->
                                    <div class="d-flex align-items-center gap-2 overflow-hidden me-2" style="min-width: 0;">
                                        @if (!string.IsNullOrEmpty(cours.EnseignantPhotoUrl))
                                        {
                                            <img src="@cours.EnseignantPhotoUrl" alt="@cours.EnseignantNom" class="teacher-avatar flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="teacher-avatar-placeholder flex-shrink-0 rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold">
                                                @(string.IsNullOrEmpty(cours.EnseignantNom) ? "U" : cours.EnseignantNom.Substring(0, 1))
                                            </div>
                                        }
                                        <div class="text-truncate">
                                            <small class="text-muted d-block line-height-1" style="font-size: 0.7rem;">Enseignant</small>
                                            <span class="fw-bold text-dark small text-truncate d-block">@cours.EnseignantNom</span>
                                        </div>
                                    </div>

                                    <!-- Bouton d'action -->
                                    <a href="/cours/@cours.Id" class="btn btn-outline-primary rounded-pill btn-sm px-3 fw-bold flex-shrink-0">
                                        Consulter →
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>


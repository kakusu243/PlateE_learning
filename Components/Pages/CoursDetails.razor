@page "/cours/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PlateE_learning.Models
@using PlateE_learning.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject CurrentUserService CurrentUserService
@implements IDisposable

<PageTitle>@(CoursData?.Titre ?? "Détail du cours") - CRMS-UOB</PageTitle>

@if (IsLoading)
{
    <div class="text-center py-5 my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <p class="text-muted mt-2">Chargement des détails du cours...</p>
    </div>
}
else if (CoursData == null)
{
    <div class="container py-5 text-center">
        <div class="alert alert-warning rounded-4 shadow-sm p-4">
            <h4>⚠️ Cours introuvable</h4>
            <p>Le cours demandé n'existe pas ou a été retiré.</p>
            <a href="/cours" class="btn btn-primary rounded-pill mt-2">Retour au catalogue</a>
        </div>
    </div>
}
else
{
    <!-- HERO SECTION DU COURS -->
    <section class="bg-dark text-white py-5 position-relative hero-course">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="badge bg-warning px-3 py-2 rounded-pill mb-3">
                        @(CoursData.Type == "Vidéo" ? "Formation Vidéo" : " Formation Texte")
                    </span>
                    <h1 class="fw-bold display-5 mb-3">@CoursData.Titre</h1>
                    <p class="lead text-light-50 mb-4 opacity-75">@CoursData.Description</p>

                    <!-- Infos Enseignant -->
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(CoursData.Enseignant?.PhotoUrl))
                        {
                            <img src="@CoursData.Enseignant.PhotoUrl"
                                 alt="@CoursData.Enseignant.NomComplet"
                                 class="rounded-circle teacher-avatar-lg" />
                        }
                        else
                        {
                            <div class="teacher-avatar-placeholder-lg rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold">
                                @(string.IsNullOrEmpty(CoursData.Enseignant?.NomComplet) ? "U" : CoursData.Enseignant.NomComplet.Substring(0, 1))
                            </div>
                        }
                        <div>
                            <small class="text-white-50 d-block line-height-1">Enseignant</small>
                            <span class="fw-bold fs-6 text-white">@(CoursData.Enseignant?.NomComplet ?? "Enseignant UOB")</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <div class="card border-0 rounded-4 shadow-lg overflow-hidden bg-white text-dark p-3">
                        <img src="@(string.IsNullOrEmpty(CoursData.MiniatureUrl) ? "images/course-default.svg" : CoursData.MiniatureUrl)"
                             class="rounded-3 img-fluid mb-3 course-detail-img" alt="@CoursData.Titre" />

                        @if (InscriptionUtilisateur != null)
                        {
                            <a href="/cours/@CoursData.Id/apprendre" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm">
                                Continuer le cours
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm" @onclick="SInscrire">
                                S'inscrire au cours
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTENU PRINCIPAL -->
    <section class="py-5 bg-light min-vh-100">
        <div class="container">
            <div class="row g-4">

                <!-- COLONNE GAUCHE : PROGRESSION & TABLE DES MATIÈRES -->
                <div class="col-lg-8">

                    <!-- BLOC PROGRESSION (Si utilisateur connecté et inscrit) -->
                    @if (InscriptionUtilisateur != null)
                    {
                        <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold m-0 text-dark">📊 Votre progression</h5>
                                <span class="badge bg-primary-subtle text-primary fw-bold">@InscriptionUtilisateur.Progression% complété</span>
                            </div>
                            <div class="progress mb-2" style="height: 10px;">
                                <div class="progress-bar bg-primary rounded-pill" role="progressbar"
                                     style="width: @InscriptionUtilisateur.Progression%;"
                                     aria-valuenow="@InscriptionUtilisateur.Progression" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="text-muted">
                                Statut : @(InscriptionUtilisateur.EstTermine ? "✅ Cours terminé" : "🔵 En cours d'apprentissage")
                            </small>
                        </div>
                    }

                    <!-- TABLE DES MATIÈRES (CHAPITRES) -->
                    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                        <h4 class="fw-bold text-dark mb-4">Table des matières (@CoursData.Chapitres.Count chapitres)</h4>

                        @if (!CoursData.Chapitres.Any())
                        {
                            <p class="text-muted mb-0">Aucun chapitre n'est encore disponible pour ce cours.</p>
                        }
                        else
                        {
                            <div class="accordion accordion-flush" id="accordionChapitres">
                                @{
                                    var chapitresTries = CoursData.Chapitres.OrderBy(c => c.Ordre).ToList();
                                    int totalChapitres = chapitresTries.Count;

                                    // Calcul du dernier chapitre accessible en fonction du % de progression dans Inscription
                                    int maxChapitreInscrit = InscriptionUtilisateur != null && totalChapitres > 0
                                        ? Math.Max(1, (int)Math.Ceiling((double)InscriptionUtilisateur.Progression / 100 * totalChapitres))
                                        : 0;
                                }

                                @foreach (var chapitre in chapitresTries)
                                {
                                    bool estDebloque = InscriptionUtilisateur != null && (chapitre.Ordre <= maxChapitreInscrit || chapitre.Ordre == 1);

                                    <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                                        <h2 class="accordion-header" id="heading-@chapitre.Id">
                                            <button class="accordion-button collapsed fw-bold text-dark d-flex justify-content-between align-items-center"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#collapse-@chapitre.Id"
                                                    aria-expanded="false"
                                                    aria-controls="collapse-@chapitre.Id">
                                                <div class="d-flex align-items-center gap-3">
                                                    <span>@(CoursData.Type == "Vidéo" ? "🎥" : "📄")</span>
                                                    <span>Chapitre @chapitre.Ordre : @chapitre.Titre</span>
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapse-@chapitre.Id" class="accordion-collapse collapse" aria-labelledby="heading-@chapitre.Id" data-bs-parent="#accordionChapitres">
                                            <div class="accordion-body bg-light text-muted small">
                                                <p class="mb-3">Accédez au contenu du chapitre pour poursuivre votre apprentissage.</p>

                                                @if (InscriptionUtilisateur != null)
                                                {
                                                    @if (estDebloque)
                                                    {
                                                        <a href="/cours/@CoursData.Id/chapitre/@chapitre.Id" class="btn btn-sm btn-primary rounded-pill fw-bold px-3">
                                                            ▶️ Rejoindre le chapitre
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-secondary rounded-pill fw-bold px-3" disabled>
                                                            🔒 Verrouillé (Terminez le chapitre précédent)
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">🔒 Connectez-vous et inscrivez-vous pour débloquer ce chapitre.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- COLONNE DROITE : DETAILS & STATS -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm p-4 bg-white sticky-top" style="top: 20px;">
                        <h5 class="fw-bold text-dark mb-3">Informations sur la formation</h5>

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">📚 Chapitres</span>
                                <span class="fw-bold">@CoursData.Chapitres.Count</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">⏱️ Durée estimée</span>
                                <span class="fw-bold">@(CoursData.Chapitres.Count * 20) min</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">Format</span>
                                <span class="fw-bold">@CoursData.Type</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">🎓 Certification</span>
                                <span class="badge bg-success-subtle text-success fw-bold">
                                    @(CoursData.Certificats != null && CoursData.Certificats.Any() ? "Inclus" : "Disponible")
                                </span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }

    private PlateE_learning.Models.Cours? CoursData;
    private PlateE_learning.Models.Inscription? InscriptionUtilisateur;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        CurrentUserService.OnChange += StateHasChanged;
        await ChargerDonneesAsync();
    }

    public void Dispose()
    {
        CurrentUserService.OnChange -= StateHasChanged;
    }

    private async Task ChargerDonneesAsync()
    {
        IsLoading = true;
        try
        {
            using var context = DbFactory.CreateDbContext();

            // Charger le cours et ses chapitres
            CoursData = await context.Cours
                .Include(c => c.Enseignant)
                .Include(c => c.Chapitres)
                .Include(c => c.Certificats)
                .FirstOrDefaultAsync(c => c.Id == Id);

            // Si l'utilisateur est connecté via CurrentUserService
            if (CurrentUserService.IsAuthenticated && CurrentUserService.CurrentUser != null)
            {
                int currentUserId = CurrentUserService.CurrentUser.Id;

                InscriptionUtilisateur = await context.Inscriptions
                    .FirstOrDefaultAsync(i => i.CoursId == Id && i.ApprenantId == currentUserId);
            }
        }
        catch (Exception)
        {
            CoursData = null;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SInscrire()
    {
        if (CoursData == null) return;

        // 1. Si non connecté, redirection vers /login
        if (!CurrentUserService.IsAuthenticated || CurrentUserService.CurrentUser == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        int currentUserId = CurrentUserService.CurrentUser.Id;

        using var context = DbFactory.CreateDbContext();

        // 2. Vérifier s'il n'est pas déjà inscrit
        bool dejaInscrit = await context.Inscriptions
            .AnyAsync(i => i.CoursId == Id && i.ApprenantId == currentUserId);

        if (!dejaInscrit)
        {
            var nouvelleInscription = new PlateE_learning.Models.Inscription
            {
                CoursId = Id,
                ApprenantId = currentUserId,
                DateInscription = DateTime.UtcNow,
                Progression = 0,
                EstTermine = false
            };

            context.Inscriptions.Add(nouvelleInscription);
            await context.SaveChangesAsync();

            InscriptionUtilisateur = nouvelleInscription;
        }
    }
}
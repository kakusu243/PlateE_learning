@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using PlateE_learning.Data
@inject NavigationManager Navigation
@inject AppDbContext _context
@inject Microsoft.AspNetCore.Identity.SignInManager<PlateE_learning.Models.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<PlateE_learning.Models.ApplicationUser> UserManager
@inject CurrentUserService CurrentUserService

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card shadow-sm">
                <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-stretch gap-4">
                    <div class="login-form flex-fill">
                        <h4 class="card-title mb-3">Se connecter</h4>

                        <EditForm Model="Credentials" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Adresse e-mail</label>
                                <InputText @bind-Value="Credentials.Email" class="form-control" placeholder="adresse@exemple.com" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mot de passe</label>
                                <InputText @bind-Value="Credentials.Password" type="password" class="form-control" />
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="Credentials.RememberMe" class="form-check-input" id="rememberMe" />
                                    <label class="form-check-label" for="rememberMe">Se souvenir</label>
                                </div>
                                <a href="#" class="small">Mot de passe oublié ?</a>
                            </div>

                            @if (!string.IsNullOrEmpty(ErrorMessage))
                            {
                                <div class="alert alert-danger mb-3">@ErrorMessage</div>
                            }

                            <div class="d-grid">
                                <button type="submit" class="btn btn-cta">Se connecter</button>
                            </div>
                        </EditForm>

                        <div class="mt-3 text-center">
                            <small>Pas de compte ? <a href="/inscription">S'inscrire</a></small>
                        </div>
                    </div>
                    <div class="login-image-wrapper d-none d-lg-flex align-items-center justify-content-center">
                        <img src="images/Login_image.jpg" alt="login_image" class="login-image" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    class LoginModel
    {
        [Required(ErrorMessage = "L'adresse e-mail est requise")]
        [EmailAddress(ErrorMessage = "Adresse e-mail invalide")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Le mot de passe est requis")]
        public string? Password { get; set; }

        public bool RememberMe { get; set; }
    }

    LoginModel Credentials = new();
    string ErrorMessage = string.Empty;

    async Task HandleValidSubmit()
    {
        ErrorMessage = string.Empty;

        try
        {
            var result = await SignInManager.PasswordSignInAsync(Credentials.Email, Credentials.Password, Credentials.RememberMe, lockoutOnFailure: false);
            if (result.Succeeded)
            {
                var appUser = await UserManager.FindByEmailAsync(Credentials.Email);
                if (appUser != null)
                {
                    CurrentUserService.SetUser(appUser);
                }

                Navigation.NavigateTo("/");
                return;
            }

            // fallback: try legacy check (in case migration not done)
            var legacy = await _context.Utilisateurs.FirstOrDefaultAsync(u => u.Email == Credentials.Email && u.MotDePasse == Credentials.Password);
            if (legacy != null)
            {
                var existing = await UserManager.FindByEmailAsync(legacy.Email);
                if (existing == null)
                {
                    var tempPwd = "Temp@" + Guid.NewGuid().ToString("N").Substring(0, 12) + "aA1!";
                    var newUser = new PlateE_learning.Models.ApplicationUser
                    {
                        UserName = legacy.Email,
                        Email = legacy.Email,
                        NomComplet = legacy.NomComplet,
                        PhotoUrl = legacy.PhotoUrl,
                        DateInscription = legacy.DateInscription,
                        MustChangePassword = true
                    };
                    var create = await UserManager.CreateAsync(newUser, tempPwd);
                    if (create.Succeeded)
                    {
                        await UserManager.AddToRoleAsync(newUser, string.IsNullOrWhiteSpace(legacy.Role) ? "Apprenant" : legacy.Role);
                        await SignInManager.PasswordSignInAsync(newUser.UserName, tempPwd, true, false);
                        CurrentUserService.SetUser(newUser);
                        Navigation.NavigateTo("/");
                        return;
                    }
                }
            }

            ErrorMessage = "Identifiants incorrects.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur lors de la connexion : {ex.Message}";
        }
    }
}
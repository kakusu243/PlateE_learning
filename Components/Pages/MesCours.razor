@page "/mes-cours"
@using PlateE_learning.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext _context
@inject CurrentUserService CurrentUserService

<div class="container py-5">
    <!-- En-tête de page -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark m-0">Mes cours</h2>
            <p class="text-muted small mb-0">Ravi de vous revoir, @CurrentUserService.CurrentUser?.NomComplet ! Reprenez là où vous vous étiez arrêté.</p>
        </div>
        <a href="/cours" class="btn btn-outline-primary rounded-pill px-4 fw-medium shadow-sm">
            Explorer le catalogue
        </a>
    </div>

    @if (!CurrentUserService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-4 shadow-sm p-4">
            <h5>⚠️ Non connecté</h5>
            <p class="mb-0">Veuillez vous connecter pour accéder à votre espace d'apprentissage.</p>
        </div>
    }
    else if (CurrentUserService.Role != "Apprenant")
    {
        <div class="alert alert-info rounded-4 shadow-sm p-4">
            <h5>ℹ️ Accès réservé</h5>
            <p class="mb-0">Cette page est dédiée aux apprenants inscris sur la plateforme.</p>
        </div>
    }
    else
    {
        @if (enrolledCourses.Any())
        {
            <div class="row g-4">
                @foreach (var inscription in enrolledCourses)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 border-0 rounded-4 shadow-sm hover-shadow transition-all overflow-hidden bg-white">

                            <!-- Image Miniature du cours -->
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(inscription.Cours?.MiniatureUrl) ? "images/course-default.jpg" : inscription.Cours.MiniatureUrl)"
                                     class="card-img-top course-thumb"
                                     alt="@inscription.Cours?.Titre"
                                     style="height: 180px; object-fit: cover;" />

                                <span class="badge bg-warning bg-opacity-75 backdrop-blur text-white position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill small">
                                    @(inscription.Cours?.Type == "Vidéo" ? "Vidéo" : "Texte")
                                </span>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <!-- Titre compact -->
                                <h5 class="fw-bold text-dark mb-1 fs-5">
                                    @inscription.Cours?.Titre
                                </h5>

                                <!-- Enseignant -->
                                <div class="d-flex align-items-center gap-1 mb-2">
                                    <span class="text-muted small">Par</span>
                                    <span class="fw-semibold small text-secondary">
                                        @(inscription.Cours?.Enseignant?.NomComplet ?? "Enseignant UOB")
                                    </span>
                                </div>

                                <!-- Description -->
                                <p class="text-muted small mb-3 lh-sm">
                                    @inscription.Cours?.Description
                                </p>

                                <!-- Bloc Progression compact -->
                                <div class="bg-light p-2 px-3 rounded-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="text-muted fw-bold" style="font-size: 0.75rem;">Progression</small>
                                        <small class="fw-bold text-primary" style="font-size: 0.75rem;">@inscription.Progression%</small>
                                    </div>
                                    <div class="progress" style="height: 5px;">
                                        <div class="progress-bar bg-primary rounded-pill"
                                             role="progressbar"
                                             style="width: @inscription.Progression%;"
                                             aria-valuenow="@inscription.Progression"
                                             aria-valuemin="0"
                                             aria-valuemax="100"></div>
                                    </div>
                                </div>

                                <!-- Action principale -->
                                <div class="pt-2 border-top mt-auto">
                                    <a href="/cours/@inscription.CoursId/apprendre"
                                       class="btn btn-warning text-white w-100 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                        <span>▶️</span>
                                        <span>@(inscription.Progression > 0 ? "Continuer le cours" : "Commencer le cours")</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- État vide (Aucun cours) -->
            <div class="text-center py-5 my-4 bg-white rounded-4 shadow-sm border p-5">
                <div class="mb-3 fs-1 text-muted">📚</div>
                <h4 class="fw-bold text-dark">Vous n'êtes inscrit à aucun cours</h4>
                <p class="text-muted col-md-6 mx-auto mb-4">
                    Explorez notre catalogue pour découvrir nos formations en ligne et commencez votre apprentissage dès aujourd'hui.
                </p>
                <a href="/cours" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                    Découvrir les cours
                </a>
            </div>
        }
    }
</div>

